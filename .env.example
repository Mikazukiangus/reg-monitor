# RegSonar configuration. Copy to .env for local use; never commit real secrets.
# Keep .env readable only by your account (chmod 600); see SECURITY.md for
# production Secret variables and the shared redacted logging helpers.
# The server and Vite config read .env once, before validating runtime-config.ts.
# Existing process/platform variables win. Restart/redeploy after changes.
# Blank optional values use defaults or leave the corresponding feature off.
# All durations below are milliseconds unless their name ends in _SECONDS.

# Local HTTP server. NODE_ENV: development | test | production.
# Leave NODE_ENV empty here so Vite can select production for builds; the local
# server defaults to development. Set NODE_ENV=production for a standalone host.
# PORT: 1..65535. HOST: IP address or hostname, without a scheme or port.
NODE_ENV=
PORT=3000
HOST=0.0.0.0
# Boolean settings accept true/false or 1/0. Disable HMR and file watching.
DISABLE_HMR=false

# Optional notice history. Without either URL the live feed still works.
# DATABASE_URL takes precedence over POSTGRES_URL, its compatibility alias.
# Use postgres:// or postgresql://; preserve provider-supplied TLS parameters.
# For in-memory local tests only: DATABASE_URL=pglite (requires dev dependencies).
# Example format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
POSTGRES_URL=
# Postgres connections per process (1..100), and idle connection timeout.
DB_POOL_MAX=3
DB_IDLE_TIMEOUT_MS=10000
# How long to wait for a database connection (Neon may be waking up, or the
# pool busy) and for each query's answer, in milliseconds.
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000

# Optional scheduled checks and email digest. All secrets are server-only.
# CRON_SECRET alone enables authorized scheduled checks and digest dry runs.
# Email sending requires CRON_SECRET + RESEND_API_KEY + at least one DIGEST_TO.
# CRON_SECRET must be at least 32 characters (e.g. `openssl rand -hex 32`);
# a shorter one keeps the scheduled jobs off. Use a Resend key with sending access.
# Leave these empty for local development; empty values disable email sending.
CRON_SECRET=
RESEND_API_KEY=
# Comma-separated email addresses, e.g. owner@example.com,team@example.com.
DIGEST_TO=
# Sender: an email address or Display Name <address>. For real delivery use
# a verified Resend domain; the default test sender has recipient restrictions.
DIGEST_FROM="RegSonar <onboarding@resend.dev>"
# Absolute HTTP(S) app base URL, no credentials/query/fragment. Used for email
# links AND the scheduled poll's feed-warming request. No trailing slash needed.
# Defaults to https://VERCEL_PROJECT_PRODUCTION_URL, else http://localhost:PORT.
# Set explicitly for other hosted environments, especially scheduled checks.
DIGEST_SITE_URL=
RESEND_TIMEOUT_MS=15000
FEED_WARM_TIMEOUT_MS=30000

# Other sites' pages allowed to call the API from a browser: comma-separated
# exact origins, e.g. https://dashboard.example.com,https://intranet.example.com
# (http only for localhost; no paths, no wildcards). Leave empty unless another
# site needs the API: the site's own page (production, previews, local dev) is
# always allowed, and requests without an Origin header (cron jobs, curl) are
# unaffected. Every other origin gets 403.
CORS_ALLOWED_ORIGINS=

# Ingestion timeouts, HTTP 429 fallback pause and per-process cache lifetimes.
# Positive decimal integers, at most 2147483647. Source Retry-After wins over
# RATE_LIMIT_PAUSE_MS. These settings do not change upstream feed addresses.
FETCH_TIMEOUT_MS=8000
RATE_LIMIT_PAUSE_MS=900000
# Tries of a call that failed for a passing reason (a dropped connection, HTTP
# 502/503/504, Resend 429/5xx), 1..5, and the first pause before trying again
# (later pauses are 3x longer, +/- half at random), in milliseconds.
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500
# Circuit breakers: after this many failures in a row (timeouts, broken
# connections, HTTP 5xx), a regulator site is not asked again for the site
# cooldown, and the history database for the database cooldown; then one
# request is let through to see whether it has recovered. Milliseconds.
BREAKER_FAILURES=3
SITE_BREAKER_COOLDOWN_MS=300000
DB_BREAKER_COOLDOWN_MS=30000
HEALTH_TTL_MS=300000
SOURCE_TTL_MS=600000
SYNC_REUSE_MS=60000

# Scheduled-check budgets. Item limits: 1..1000; backfill must be >= POLL_LIMIT.
# Key-point fetches and date backfills: 0..1000 (0 skips that work).
# The fetch window limits when NEW document reads start, not total execution.
# Keep it below the function's 120s limit in vercel.json, allowing time for
# in-flight fetches and database work. These values do not change cron schedules.
POLL_LIMIT=20
POLL_BACKFILL_LIMIT=50
POLL_KEY_POINT_FETCHES=5
POLL_FETCH_WINDOW_MS=60000
POLL_DATE_BACKFILL_LIMIT=5

# History included in the feed: days 1..3650; maximum notices 1..10000.
# Notices also in the live feed don't count against the maximum. Each notice
# adds about 2.2 KB to the feed reply; Vercel refuses function replies over
# 4.5 MB, so keep the maximum below about 1800.
ARCHIVE_FEED_DAYS=30
ARCHIVE_FEED_LIMIT=1000

# Visitor-triggered refreshes per window, per server process (the other API
# limits are fixed in server/rate-limits.ts).
# Limit 1..1000; window is a positive duration in milliseconds.
REFRESH_LIMIT=6
REFRESH_WINDOW_MS=60000

# Public GET response caching at the CDN (seconds, 0..31536000).
# POST refreshes, cron routes and private/configuration status stay no-store.
SYNC_CDN_TTL_SECONDS=300
SYNC_CDN_STALE_SECONDS=86400
SEARCH_CDN_TTL_SECONDS=300
SEARCH_CDN_STALE_SECONDS=3600

# Vercel-managed variables. Normally supplied by the platform; leave empty here.
# VERCEL=true/1 trusts Vercel's forwarded client-IP header and skips local listen.
# VERCEL_PROJECT_PRODUCTION_URL is a hostname only, without https:// or a path.
VERCEL=
VERCEL_PROJECT_PRODUCTION_URL=

# Never prefix secrets with VITE_: Vite exposes that prefix to browser bundles.
# No application-specific VITE_* variables are required by this project.
# Region, function duration, cron schedules and CSP stay in vercel.json.
# Regulator URLs/parser rules, business time zones and the existing PDF/OCR
# safety limits stay in code. Dependency and PDF-hardening work remains deferred.
