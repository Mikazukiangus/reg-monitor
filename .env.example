# PORT: Port for the Express server (default 3000).
# PORT=3000

# Daily email digest (digest.ts, rules in digest-rules.ts). Set these in the
# Vercel project's environment variables; the digest is off until all three
# of CRON_SECRET, RESEND_API_KEY and DIGEST_TO are set.
# CRON_SECRET: a long random string. Vercel sends it to /api/digest so nobody
#   else can trigger emails.
# CRON_SECRET=
# RESEND_API_KEY: an API key from resend.com (Sending access is enough).
# RESEND_API_KEY=
# DIGEST_TO: where the digest goes. With Resend's test sender this must be the
#   address you signed up to Resend with.
# DIGEST_TO=
# DIGEST_FROM: optional. Defaults to Resend's test sender
#   "RegSonar <onboarding@resend.dev>"; use an address on a domain you have
#   verified in Resend to send elsewhere.
# DIGEST_FROM=
