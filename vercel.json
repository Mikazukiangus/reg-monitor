{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hkg1"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core,@tesseract.js-data/eng,bmp-js,idb-keyval,is-url,node-fetch,whatwg-url,tr46,webidl-conversions,regenerator-runtime,wasm-feature-detect,zlibjs}/**"
    }
  }
}
