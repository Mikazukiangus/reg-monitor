{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hkg1"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-pBiHyKXh9J7mhYKU+zSytA0kvZL+gubY0erAvP+1TqU='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core,@tesseract.js-data/eng,bmp-js,idb-keyval,is-url,node-fetch,whatwg-url,tr46,webidl-conversions,regenerator-runtime,wasm-feature-detect,zlibjs}/**"
    }
  },
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/feeds/poll",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/feeds/poll",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/feeds/poll",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/feeds/poll",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/feeds/poll",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/feeds/poll",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/feeds/poll",
      "schedule": "0 21 * * *"
    }
  ]
}
